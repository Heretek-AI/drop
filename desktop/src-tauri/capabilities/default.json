{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Capability for the main window",
  "identifier": "default",
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "deep-link:default",
    "dialog:default",
    "os:default",
    "opener:default"
  ],
  "windows": ["main"]
}
